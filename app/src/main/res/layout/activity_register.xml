<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_green_background"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Créer un compte"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"
            android:text="Choisissez votre type de compte"
            android:textColor="#E0F7E9"
            android:textSize="16sp" />

        <!-- Formulaire principal -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Logo avec cercle vert -->
                <androidx.cardview.widget.CardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="4dp"
                    android:background="#4CAF50"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_medical"
                        android:scaleType="centerInside"
                        android:padding="20dp"
                        android:contentDescription="Logo médical"
                        />

                </androidx.cardview.widget.CardView>

                <!-- Section 1: Type de compte -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Type de compte *"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgAccountType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbPatient"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:padding="12dp"
                        android:text="Patient"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:buttonTint="#4CAF50" />

                    <RadioButton
                        android:id="@+id/rbDoctor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="12dp"
                        android:text="Médecin"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:buttonTint="#4CAF50" />

                </RadioGroup>

                <!-- Message d'information -->
                <TextView
                    android:id="@+id/txtMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="#E8F5E9"
                    android:padding="16dp"
                    android:textColor="#1B5E20"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:text="Message d'information" />

                <!-- Section 2: Informations personnelles -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Informations personnelles"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Nom complet -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Nom complet *"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="#4CAF50"
                    app:boxStrokeColor="#4CAF50"
                    app:hintTextColor="#4CAF50"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ex: Jean Dupont"
                        android:inputType="textCapWords"
                        android:textSize="15sp"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Adresse email *"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:startIconDrawable="@android:drawable/ic_dialog_email"
                    app:startIconTint="#4CAF50"
                    app:boxStrokeColor="#4CAF50"
                    app:hintTextColor="#4CAF50"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ex: jean.dupont@email.com"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Téléphone -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Téléphone *"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    app:startIconDrawable="@android:drawable/ic_menu_call"
                    app:startIconTint="#4CAF50"
                    app:boxStrokeColor="#4CAF50"
                    app:hintTextColor="#4CAF50"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ex: 0123456789"
                        android:inputType="phone"
                        android:textSize="15sp"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section 3: Cabinet (médecin seulement) -->
                <LinearLayout
                    android:id="@+id/sectionCabinet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:background="#E8F5E9"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Informations du cabinet"
                        android:textColor="#1B5E20"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Nom du cabinet -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Nom du cabinet *"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:startIconTint="#4CAF50"
                        app:boxStrokeColor="#4CAF50"
                        app:hintTextColor="#4CAF50"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCabinetName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ex: Cabinet Médical Dupont"
                            android:inputType="textCapWords"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Adresse du cabinet -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Adresse du cabinet *"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:startIconDrawable="@android:drawable/ic_menu_mapmode"
                        app:startIconTint="#4CAF50"
                        app:boxStrokeColor="#4CAF50"
                        app:hintTextColor="#4CAF50"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCabinetAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ex: 123 Rue de la Santé, 75000 Paris"
                            android:inputType="textCapWords"
                            android:textSize="15sp"
                            android:textColor="#333333" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Spécialité -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Spécialité médicale *"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@android:drawable/ic_menu_help"
                        app:startIconTint="#4CAF50"
                        app:boxStrokeColor="#4CAF50"
                        app:hintTextColor="#4CAF50"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <AutoCompleteTextView
                            android:id="@+id/editSpeciality"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Sélectionnez une spécialité"
                            android:textSize="15sp"
                            android:textColor="#333333"
                            android:completionThreshold="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Section 4: Mot de passe -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Sécurité du compte"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Mot de passe -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Mot de passe *"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:startIconDrawable="@android:drawable/ic_lock_lock"
                    app:startIconTint="#4CAF50"
                    app:endIconMode="password_toggle"
                    app:boxStrokeColor="#4CAF50"
                    app:hintTextColor="#4CAF50"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Minimum 6 caractères"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirmation mot de passe -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Confirmer le mot de passe *"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    app:startIconDrawable="@android:drawable/ic_lock_lock"
                    app:startIconTint="#4CAF50"
                    app:endIconMode="password_toggle"
                    app:boxStrokeColor="#4CAF50"
                    app:hintTextColor="#4CAF50"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Répétez votre mot de passe"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:textColor="#333333" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Bouton d'inscription -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Créer mon compte"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:elevation="6dp"
                    android:backgroundTint="#4CAF50"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF"
                    app:iconPadding="8dp" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Lien connexion -->
        <TextView
            android:id="@+id/txtLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="16dp"
            android:text="Déjà un compte ? Se connecter"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>