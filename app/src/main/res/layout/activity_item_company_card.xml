<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:id="@+id/companyCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tête avec indicateur de disponibilité -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/availabilityIndicator"
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:background="@color/medical_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/tvCabinetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cabinet Médical Central"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvDoctorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Ahmed Ben Salah"
                    android:textSize="14sp"
                    android:textColor="@color/gray" />

            </LinearLayout>

            <!-- CORRECTION : Utiliser la couleur directement -->
            <TextView
                android:id="@+id/tvSpeciality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardiologie"
                android:textSize="12sp"
                android:background="@drawable/chip_background"
                android:padding="8dp"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- Adresse -->
        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="123 Rue de la Santé, Sfax"
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:drawableStart="@android:drawable/ic_menu_mylocation"
            android:drawablePadding="4dp"
            android:layout_marginTop="8dp" />

        <!-- Disponibilité -->
        <TextView
            android:id="@+id/tvAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponible aujourd'hui"
            android:textSize="12sp"
            android:textColor="@color/medical_green"
            android:drawablePadding="4dp"
            android:layout_marginTop="4dp" />

        <!-- Horaires -->
        <TextView
            android:id="@+id/tvSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕐 08:00-12:00, 14:00-18:00"
            android:textSize="11sp"
            android:textColor="@color/gray"
            android:layout_marginTop="2dp" />

        <!-- CORRECTION : Utiliser medical_green au lieu de purple_500 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBook"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Prendre Rendez-vous"
            android:textSize="14sp"
            app:cornerRadius="20dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/medical_green" />

    </LinearLayout>

</androidx.cardview.widget.CardView>