<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAppointment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ligne 1: Nom du patient et statut -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <!-- Nom du patient -->
            <TextView
                android:id="@+id/tvPatientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Patient Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Badge de statut -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En attente"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/badge_background"
                android:textAllCaps="true"
                android:maxLines="1"/>

        </LinearLayout>

        <!-- Ligne 2: Date et heure -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="01/01/2024"
                android:textSize="14sp"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_calendar"
                android:maxLines="1"/>

            <!-- Heure -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textSize="14sp"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_time"
                android:maxLines="1"/>

        </LinearLayout>

        <!-- Ligne 3: Cabinet -->
        <TextView
            android:id="@+id/tvCabinet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cabinet Médical"
            android:textSize="14sp"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_hospital"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Ligne optionnelle: Notes (visible uniquement si existantes) -->
        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="12sp"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_note"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>